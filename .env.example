# Copy this file to .env and fill in your credentials.

# Required to run tickets and evaluations with the default OpenAI model.
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Set LANGSMITH_API_KEY to run evaluations or synchronize the dataset.
# Set LANGSMITH_TRACING=true to also trace interactive ticket runs.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=soporte-multiagente
LANGSMITH_DATASET_NAME=techstore-support-golden-v1
# Uncomment for an EU LangSmith workspace.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
